# Supabase — used by /api/register to store registrations.
# Copy this file to .env.local and fill in real values, then restart the dev server.
#
# Either naming convention works:
#
#   (a) this project's default
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
#
#   (b) the names the main Verikon site already uses — uncomment these instead
#       if you point this at the same Supabase project
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SECRET_KEY=your-secret-key
#
# The key MUST be a secret / service-role key, not the anon key. The registrations
# table has RLS enabled with no public write policy, so an anon key will be rejected.
# Never prefix a secret key with NEXT_PUBLIC_ — that ships it to the browser.
